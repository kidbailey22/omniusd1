{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/decoder", "destination": "/OmniIntelDecoder.html" },
    { "source": "/mode-engine", "destination": "/OmniModeEngine.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
