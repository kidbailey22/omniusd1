{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "api": {
    "bodyParser": {
      "sizeLimit": "10mb"
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/decoder", "destination": "/OmniIntelDecoder.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
